{
  "schemaVersion": 1,
  "id": "madoku-craft-ecosystem",
  "version": "${version}",
  "name": "Madoku Craft: Ecosystem",
  "description": "A configurable ecosystem mod.",
  "authors": ["Monkeyopolis"],
  "license": "CC0-1.0",
  "environment": "*",
  "entrypoints": {
    "main": ["madoku.craft.java.ecosystem.MadokuEcosystemInitializer"]
  },
  "mixins": ["madoku-craft-ecosystem.mixins.json"],
  "depends": {
    "fabricloader": "${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "${fabric_api_version}",
    "madoku-craft-core": "*"
  }
}
